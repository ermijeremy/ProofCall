# Copy to .env and fill in. .env is gitignored; never commit real keys.

# One key, or many as a JSON array. Several keys are spread round-robin and
# failed over on quota, so a demo running twenty interviews does not stall on one
# key's per-minute limit.
#
#   GEMINI_API_KEY=AIzaSy...
#   GEMINI_API_KEY=["AIzaSy...","AIzaSy...","AQ.Ab8..."]
#
# Comma- and space-separated lists are accepted too. GOOGLE_API_KEY works as a
# fallback name.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash.
#
# Do not set this to gemini-2.5-flash. Google now gates that model to projects
# that already used it, and a newer key gets:
#   404 NOT_FOUND ... no longer available to new users
# The model still appears in models.list() for such keys, so the failure only
# shows up on the first real call.
# GEMINI_MODEL=gemini-3.6-flash

# TeleExpert connection. The webhook URL must be publicly reachable over HTTPS.
TELEXPERT_BASE_URL=http://192.168.43.36:8080
TELEXPERT_API_KEY=
TELEXPERT_TIMEOUT_SECONDS=60
TELEXPERT_ANSWER_TIMEOUT_SECONDS=45
TELEXPERT_WEBHOOK_URL=https://your-public-host.example/api/teleexpert/webhook
TELEXPERT_WEBHOOK_SECRET=

# The web server automatically submits due interviews; the dashboard button
# remains available as a manual recovery action.
CALLPROOF_SCHEDULER_ENABLED=true
CALLPROOF_SCHEDULER_INTERVAL_SECONDS=10
